# URL of the Cloudflare Worker that handles the stats "Actualiser" button
# (see cloudflare-worker/README.md). The refresh button hides itself when
# this is unset. Not sensitive - it ends up in the public JS bundle - so it
# can also be set as a plain repo *variable* (not secret) in
# Settings > Secrets and variables > Actions > Variables, named
# STATS_REFRESH_URL, which .github/workflows/depoy.yml passes through at
# build time.
VITE_STATS_REFRESH_URL=
